# Production environment variables for Docker Compose
# Copy this file to .env.prod and fill in your values

# Database credentials
DB_USER=postgres
DB_PASSWORD=secure_password_here

# Telegram configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
# The community group — membership gating, game announcements, and late sign-out notifications
TELEGRAM_GROUP_ID=your_group_id_here
# Topic (thread) within the group where recreational game-opening announcements are posted
TELEGRAM_ANNOUNCEMENTS_TOPIC_ID=
# Optional: topic (thread) ID within TELEGRAM_GROUP_ID where late sign-out alerts are posted
TELEGRAM_LATE_SIGNOUT_TOPIC_ID=
MINI_APP_URL=https://your-app-url.example.com


# Optional: override Bunq API base (defaults to https://api.bunq.com/v1)
# For sandbox testing you might set it to https://public-api.sandbox.bunq.com/v1
BUNQ_API_URL=

# JWT secret for signing auth cookies
JWT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
