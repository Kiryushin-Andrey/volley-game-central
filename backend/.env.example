####################################
# Volley Game Central - Backend ENV #
####################################

# Server
PORT=3000

# CORS / WebApp URL (public HTTPS URL used by Telegram WebApp button)
# For local dev, set this to your tunnel URL when testing in Telegram
# e.g. https://abc123.pinggy.link
MINI_APP_URL=http://127.0.0.1:3001

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=volley_game_central

# Telegram Bot
# Obtain from @BotFather
TELEGRAM_BOT_TOKEN=

# The community group — used for membership gating, game announcements, and late sign-out notifications
TELEGRAM_GROUP_ID=

# Topic (thread) within TELEGRAM_GROUP_ID where recreational game-opening announcements are posted
TELEGRAM_ANNOUNCEMENTS_TOPIC_ID=

# Optional: topic (thread) ID within TELEGRAM_GROUP_ID where late sign-out alerts are posted
TELEGRAM_LATE_SIGNOUT_TOPIC_ID_POSITIONS=
TELEGRAM_LATE_SIGNOUT_TOPIC_ID_NON_POSITIONS=
# Optional: override 5-minute waitlist invite spacing (ms) for tests
# SPOT_OFFER_INVITE_SPACING_MS=300000
# Optional: override spot-offer poller interval (ms); default 30000
# SPOT_OFFER_POLLER_INTERVAL_MS=30000

# Bunq API
# Override only if you use a custom endpoint (rare)
BUNQ_API_URL=https://api.bunq.com/v1
# E2E / local: bunq-mock listens at http://127.0.0.1:3998/v1 (npm run bunq-mock:dev from repo root).

# Optional: used to build email-like aliases in payment requests
EMAIL_DOMAIN=volley-game-central.com

# SMS (Twilio) - optional in dev; required in prod for phone auth
# Create at https://www.twilio.com/
#
# You can authenticate with:
#    - TWILIO_ACCOUNT_SID (starts with AC)
#    - TWILIO_API_KEY_SID (starts with SK)
#    - TWILIO_API_KEY_SECRET
#
# Messaging Service SID is required to send messages
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=

# App name used in SMS texts
APP_NAME=VolleyBot

# JWT secret for signing auth cookies
JWT_SECRET=

